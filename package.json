{
  "name": "wavepx",
  "version": "0.1.0",
  "description": "Transmit files, images & data over sound — an application framework built on ggwave. Fountain codes, deflate compression, battleship over audio.",
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/index.js",
      "types": "./dist/lib/index.d.ts"
    }
  },
  "bin": {
    "wavepx": "bin/wavepx.mjs"
  },
  "files": [
    "dist/lib",
    "bin"
  ],
  "scripts": {
    "build": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "ggwave",
    "data-over-sound",
    "audio",
    "file-transfer",
    "fountain-codes",
    "qr-code",
    "pixel-art",
    "compression",
    "battleship",
    "sonic"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xNtive/wavepx.git"
  },
  "homepage": "https://github.com/0xNtive/wavepx#readme",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ggwave": "^0.4.0",
    "qrcode": "^1.5.4"
  }
}
